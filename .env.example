# Groq Primary Key (Required for zero-friction setup)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Configuration
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=4

# Google Gemini API Fallback (Optional)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# High-Speed Free Cloud Fallbacks (Optional)
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Local LLM Fallback (Optional)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3

# Server Config
HOST=0.0.0.0
PORT=8000
